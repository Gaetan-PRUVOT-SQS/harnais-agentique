def noms_pour(chemin):
    """Contrôles rapides qu'un fichier changé peut casser. Docs, mémoire et regles/ restent vides."""
    partiel = PurePosixPath(chemin)
    if partiel.as_posix() == '.cyber-ignore':
        return {'baseline (cyber-scan)'}
    if partiel.as_posix() == '.gitleaksignore':
        return {'secrets (gitleaks)'}
    tete = partiel.parts[0] if partiel.parts else ''
    if tete in ('hooks', 'tests') or partiel.name in ('verifier', 'pyproject.toml'):
        return set(CONTROLES_CODE)
    if partiel.as_posix() == 'AGENTS.md':
        return {NOM_REGLE_TESTS}
    if partiel.as_posix() == 'DESIGN.md':
        return {'tests du verifier'}
    if tete == 'agents':
        return {'agents : structure et liens'}
    if tete != 'skills':
        return set()
    noms = set(CONTROLES_SKILLS)
    noms.add('secrets (gitleaks)')
    if partiel.as_posix() == 'skills/validation-gate/SKILL.md':
        noms.add('tests du verifier')
    if partiel.as_posix() in SKILLS_REGLE_TESTS:
        noms.add(NOM_REGLE_TESTS)
    if partiel.suffix in ('.c', '.h'):
        noms.add('hooks (verify.py)')
    if partiel.suffix in ('.sh', '.bash', ''):
        noms |= {'shellcheck', 'checkbashisms'}
    return noms


def fichiers_changes(chemins, racine=RACINE):
    for chemin in chemins:
        dossier = racine / chemin
        if dossier.is_dir():
            yield from (str(f.relative_to(racine)) for f in sorted(dossier.rglob('*')) if f.is_file())
        else:
            yield chemin


def controles_pour(chemins, controles):
    noms = set().union(*(noms_pour(chemin) for chemin in chemins)) if chemins else set()
    return [controle for controle in controles if controle[0] in noms]


def suites_python(dossier, nom):
    controles = [(f'{nom} : pytest', commande([sys.executable, '-m', 'pytest', '-q'], dossier)),
                 (f'{nom} : ruff', commande(['ruff', 'check', '--no-cache', '.'], dossier))]
    if '[tool.mypy]' in (dossier / 'pyproject.toml').read_text(encoding='utf-8'):
        controles.append((f'{nom} : mypy', commande(['mypy', '.'], dossier)))
    return controles


def cibles_make(makefile):
    return re.findall(r'^(verifier|test|clean):', makefile.read_text(encoding='utf-8'), re.MULTILINE)


def controle_make(makefile):
    cibles = cibles_make(makefile)
    cible = 'verifier' if 'verifier' in cibles else ('test' if 'test' in cibles else None)
    if cible is None:
        return None
    dossier = makefile.parent
    nettoyage = ['make', '-C', str(dossier), 'clean'] if 'clean' in cibles else None
    return (f'make {cible} : {dossier.relative_to(RACINE)}',
            commande(['make', '-C', str(dossier), cible], apres=nettoyage))


def controles_complets():
    controles = controles_rapides()
    for pyproject in sorted((RACINE / 'skills').glob('*/scripts/pyproject.toml')):
        controles += suites_python(pyproject.parent, pyproject.parent.parent.name)
    controles += suites_python(RACINE / 'statusline', 'statusline')
    for bats in sorted({f.parent for f in fichiers_suivis('skills') if f.suffix == '.bats'}):
        controles.append((f'bats : {bats.relative_to(RACINE)}', commande(['bats', str(bats)])))
    makes = (controle_make(f) for f in fichiers_suivis('skills') if f.name == 'Makefile')
    return controles + [controle for controle in makes if controle]


def etat(ok):
    return 'OK' if ok else ('NL' if ok is None else 'KO')


def afficher(nom, ok, sortie, duree):
    print(f'{etat(ok)}  {nom:<55} {duree:6.1f} s', flush=True)
    lignes = sortie.strip().splitlines()
    if not ok or (lignes and len(lignes) == 1):
        for ligne in lignes[-LIGNES_ECHEC:]:
            print('    ' + ligne)


def bilan(etats):
    ko, non_lances = etats.count('KO'), etats.count('NL')
    if not ko and not non_lances:
        return 'Bilan : tout est vert', 0
    return f'Bilan : {ko} KO, {non_lances} non lancés', (1 if ko else NON_LANCE)


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--rapide', action='store_true',
                        help='hooks, lint, scans, skills et budget seulement')
    parser.add_argument('--pour', nargs='+', metavar='CHEMIN',
                        help='ne garder que les contrôles concernés par ces fichiers de la config')
    args = parser.parse_args()
    controles = controles_rapides() if args.rapide else controles_complets()
    if args.pour:
        controles = controles_pour(list(fichiers_changes(args.pour)), controles)
        if not controles:
            print('Rien à vérifier pour : ' + ', '.join(args.pour))
            return 0
    etats = []
    for nom, controle in controles:
        debut = time.monotonic()
        ok, sortie = controle()
        afficher(nom, ok, sortie, time.monotonic() - debut)
        etats.append(etat(ok))
    message, code = bilan(etats)
    print(message)
    return code


if __name__ == '__main__':
    sys.exit(main())
