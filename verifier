def frontmatter(texte):
    if not texte.startswith('---\n'):
        raise ValueError('frontmatter absent')
    fin = texte.find('\n---', 3)
    if fin < 0:
        raise ValueError('frontmatter non fermé')
    donnees = yaml.safe_load(texte[4:fin])
    if not isinstance(donnees, dict):
        raise TypeError('frontmatter qui n\'est pas un objet')
    return donnees


def entree_listing(nom, donnees):
    if donnees.get('disable-model-invocation') is True:
        return 0
    texte = str(donnees.get('description') or '') + str(donnees.get('when_to_use') or '')
    return len(nom) + min(len(texte), MAX_DESCRIPTION)


def taille_listing(skills):
    return sum(entree_listing(nom, frontmatter(chemin.read_text(encoding='utf-8'))) for nom, chemin in skills)


def plugins_actifs(settings, installes, dossier_plugins):
    actifs = [cle for cle, actif in settings.get('enabledPlugins', {}).items() if actif]
    for cle in actifs:
        for installation in installes.get('plugins', {}).get(cle, [])[:1]:
            yield cle.split('@')[0], dossier_plugins / installation['installPath']


def skills_listes(skills, liens, plugins):
    yield from ((d.name, d / 'SKILL.md') for d in sorted(skills.iterdir()) if (d / 'SKILL.md').is_file())
    for chemin in sorted((liens / 'synced').glob('*/*/SKILL.md')):
        yield 'anthropic-skills:' + chemin.parent.name, chemin
    for nom, dossier in plugins:
        for chemin in sorted(dossier.glob('skills/*/SKILL.md')):
            yield nom + ':' + chemin.parent.name, chemin


def lire_json(chemin):
    try:
        return json.loads(chemin.read_text(encoding='utf-8'))
    except (OSError, json.JSONDecodeError):
        return {}


def controle_budget(skills=RACINE / 'skills', moteur=MOTEUR):
    chemin = moteur / 'settings.json'
    settings = lire_json(chemin)
    env = settings.get('env') if isinstance(settings.get('env'), dict) else {}
    budget = env.get('SLASH_COMMAND_TOOL_CHAR_BUDGET')
    if str(budget or '').isdigit():
        plugins = plugins_actifs(
            settings,
            lire_json(moteur / 'plugins' / 'installed_plugins.json'),
            moteur / 'plugins',
        )
        total = taille_listing(skills_listes(skills, moteur / 'skills', plugins))
        return verdict_budget(total, int(budget))
    total = taille_listing(skills_listes(skills, moteur / 'skills', ()))
    return verdict_budget(total, BUDGET_LISTING)


def verdict_budget(total, budget):
    plafond = int(budget * MARGE_BUDGET)
    return total <= plafond, f'listing {total} caractères, plafond {plafond} ({MARGE_BUDGET:.0%} de {budget})'


