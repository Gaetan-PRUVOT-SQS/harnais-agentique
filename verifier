def probleme_description(texte):
    if not isinstance(texte, str) or not texte.strip():
        return 'description vide'
    if len(texte) > MAX_DESCRIPTION_SKILL:
        return f'description de {len(texte)} caractères, plafond {MAX_DESCRIPTION_SKILL}'
    return None


def probleme_skill(dossier, liens):
    fichier = dossier / 'SKILL.md'
    if not dossier.is_dir():
        return 'fichier parasite dans skills/'
    if not fichier.is_file():
        return 'SKILL.md absent'
    try:
        donnees = frontmatter(fichier.read_text(encoding='utf-8'))
    except (ValueError, TypeError, yaml.YAMLError) as erreur:
        return f'frontmatter invalide ({str(erreur).splitlines()[0]})'
    if donnees.get('name') != dossier.name:
        return f'name « {donnees.get("name")} » différent du dossier'
    probleme = probleme_description(donnees.get('description'))
    if probleme:
        return probleme
    if liens is None:
        return None
    lien = liens / dossier.name
    if not lien.is_symlink() or lien.resolve() != dossier.resolve():
        return f'lien absent ou faux dans {liens}'
    return None


def problemes_structure(skills, liens):
    exiger_liens = liens.is_dir()
    for dossier in sorted(skills.iterdir()):
        probleme = probleme_skill(dossier, liens if exiger_liens else None)
        if probleme:
            yield f'{dossier.name} : {probleme}'
    if not exiger_liens:
        return
    for lien in sorted(liens.iterdir()):
        if lien.name != 'synced' and (not lien.exists() or lien.resolve().parent != skills.resolve()):
            yield f'{lien.name} : lien mort ou hors de {skills}'


def controle_structure(skills=RACINE / 'skills', liens=MOTEUR / 'skills'):
    problemes = list(problemes_structure(skills, liens))
    if problemes:
        return False, '\n'.join(problemes)
    nombre = sum(1 for _ in skills.iterdir())
    suite = 'liens complets' if liens.is_dir() else 'sans dossier de liens'
    return True, f'{nombre} skills, {suite}'


def probleme_agent(fichier, liens):
    try:
        donnees = frontmatter(fichier.read_text(encoding='utf-8'))
    except (ValueError, TypeError, yaml.YAMLError) as erreur:
        return f'frontmatter invalide ({str(erreur).splitlines()[0]})'
    if donnees.get('name') != fichier.stem:
        return f'name « {donnees.get("name")} » différent du fichier'
    if not str(donnees.get('description') or '').strip():
        return 'description vide'
    outils = {outil.strip() for outil in str(donnees.get('tools') or '').split(',') if outil.strip()}
    if not outils:
        return 'liste d\'outils absente'
    if outils & OUTILS_ECRITURE:
        return 'outil d\'écriture : un seul écrivain'
    if liens is None:
        return None
    lien = liens / fichier.name
    if not lien.is_symlink() or lien.resolve() != fichier.resolve():
        return f'lien absent ou faux dans {liens}'
    return None


def problemes_agents(agents, liens):
    exiger_liens = liens.is_dir()
    for fichier in sorted(agents.iterdir()):
        probleme = probleme_agent(fichier, liens if exiger_liens else None) if fichier.suffix == '.md' \
            else 'fichier parasite dans agents/'
        if probleme:
            yield f'{fichier.name} : {probleme}'
    if not exiger_liens:
        return
    for lien in sorted(liens.iterdir()):
        if not lien.exists() or lien.resolve().parent != agents.resolve():
            yield f'{lien.name} : lien mort ou hors de {agents}'


