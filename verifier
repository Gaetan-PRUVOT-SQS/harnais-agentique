def commande_hook(racine, evenement):
    return f'AGENT_CONFIG_ROOT={racine} python3 -E -s {racine / "hooks" / "dispatch.py"} {evenement}'


def problemes_hooks(donnees, racine):
    hooks = donnees.get('hooks') if isinstance(donnees, dict) else None
    if not isinstance(hooks, dict):
        yield 'hooks absent'
        return
    if hooks.get('enabled') is not True:
        yield 'enabled: true attendu'
    evenements = hooks.get('events')
    if not isinstance(evenements, dict):
        yield 'events absent'
        return
    for evenement in evenements:
        if evenement not in DELAIS_HOOKS:
            yield f'{evenement} : événement inattendu'
    for evenement in EVENEMENTS_HOOKS:
        if evenement not in evenements:
            yield f'{evenement} : absent'
            continue
        groupes = evenements[evenement]
        if not isinstance(groupes, list) or len(groupes) != 1 or not isinstance(groupes[0], dict):
            yield f'{evenement} : un seul groupe attendu'
            continue
        groupe = groupes[0]
        filtre = FILTRES_HOOKS.get(evenement)
        if filtre:
            if groupe.get('matcher') != filtre:
                yield f'{evenement} : filtre {groupe.get("matcher")}'
        elif groupe.get('matcher'):
            yield f'{evenement} : filtre inattendu'
        entrees = groupe.get('hooks')
        if not isinstance(entrees, list) or len(entrees) != 1 or not isinstance(entrees[0], dict):
            yield f'{evenement} : une seule commande attendue'
            continue
        hook = entrees[0]
        if 'statusMessage' in hook:
            yield f'{evenement} : statusMessage'
        if hook.get('type') != 'command':
            yield f'{evenement} : type {hook.get("type")}'
        if hook.get('command') != commande_hook(racine, evenement):
            yield f'{evenement} : commande {hook.get("command")}'
        if hook.get('timeout') != DELAIS_HOOKS[evenement]:
            yield f'{evenement} : délai {hook.get("timeout")}'


def motifs_bash(refus):
    for regle in refus:
        if isinstance(regle, str) and regle.startswith('Bash(') and regle.endswith(')'):
            yield regle[5:-1]


def commande_couverte(commande, motifs):
    texte = commande.lstrip()
    morceaux = [texte, *(morceau.strip() for morceau in re.split(r'\|\||&&|[;|\n]', texte))]
    return any(morceau and fnmatch.fnmatchcase(morceau, motif) for morceau in morceaux for motif in motifs)


def problemes_refus(deny, disabled):
    if not isinstance(deny, list) or not all(isinstance(regle, str) for regle in deny):
        yield 'deny absent ou illisible'
        return
    for regle in REFUS_SECRETS:
        if regle not in deny:
            yield f'refus absent : {regle}'
    if not isinstance(disabled, list) or PLUGIN_COUPE not in disabled:
        yield f'{PLUGIN_COUPE} encore chargé'


