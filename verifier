    problemes = list(problemes_agents(agents, liens))
    if problemes:
        return False, '\n'.join(problemes)
    nombre = sum(1 for _ in agents.iterdir())
    suite = 'liens complets' if liens.is_dir() else 'sans dossier de liens'
    return True, f'{nombre} agents, {suite}'


def fichiers_suivis(*dossiers):
    sortie = subprocess.run(['git', '-C', str(RACINE), 'ls-files', '-co', '--exclude-standard', '--', *dossiers],
                            capture_output=True, text=True, check=True).stdout
    return [RACINE / ligne for ligne in sortie.splitlines() if (RACINE / ligne).is_file()]


def premiere_ligne(chemin):
    try:
        with chemin.open('rb') as fichier:
            return fichier.readline(200).decode(errors='replace')
    except OSError:
        return ''


def scripts_shell(posix_seulement=False):
    motif = SHEBANG_POSIX if posix_seulement else SHEBANG_SHELL
    return [str(f) for f in fichiers_suivis('hooks', 'skills')
            if (not posix_seulement and f.suffix in ('.sh', '.bash')) or motif.match(premiere_ligne(f))]


def commande(argv, dossier=RACINE, apres=None, env_extra=None):
    def lancer():
        env = dict(os.environ, PYTHONDONTWRITEBYTECODE='1')
        if env_extra:
            env.update(env_extra)
        try:
            fini = subprocess.run(argv, cwd=dossier, capture_output=True, text=True, env=env,
                                  timeout=DELAI, check=False)
        except FileNotFoundError:
            return None, f'non lancé, outil absent : {argv[0]}'
        except subprocess.TimeoutExpired:
            return False, f'délai de {DELAI} s dépassé'
        finally:
            if apres:
                subprocess.run(apres, cwd=dossier, capture_output=True, timeout=DELAI, check=False)
        sortie = fini.stdout + fini.stderr
        return verdict_code(fini.returncode, sortie), sortie
    return lancer


def verdict_code(code, sortie):
    if code == 0:
        return True
    return None if code == NON_LANCE or MARQUE_NON_LANCE in sortie else False


def lint_shell():
    scripts = scripts_shell()
    if not scripts:
        return True, 'aucun script'
    return commande(['shellcheck', '-S', 'info', '-x', '-e', 'SC1091', *scripts])()


def bashismes():
    exceptions = {str(RACINE / chemin) for chemin in EXCEPTIONS_BASHISMES}
    scripts = [s for s in scripts_shell(posix_seulement=True) if s not in exceptions]
    if not scripts:
        return True, 'aucun script sh'
    return commande(['checkbashisms', '-p', *scripts])()


